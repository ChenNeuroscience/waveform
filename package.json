{
  "name": "waveform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first LTX spike exploration with Rust/Wasm, React and WebGL2",
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build:wasm && vitest run",
    "test:rust": "cargo test --manifest-path core/Cargo.toml",
    "bench": "node scripts/benchmark.mjs",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenNeuroscience/waveform.git"
  },
  "author": "Daniel Manson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ChenNeuroscience/waveform/issues"
  },
  "homepage": "https://github.com/ChenNeuroscience/waveform#readme"
}
